# The design index: every record in decisions/, by number, and what superseded it in whole or in part
# (template-obsidian decisions 0001, 0002 and 0003). Created falls back to `date` for records written before `created`.
# Template-owned: copier update replaces it. Want another view? Add a base of your own.
formulas:
  created: 'if(note.created, note.created, note.date)'
filters:
  and:
    - file.inFolder("decisions")
    - kind == "decision"
properties:
  note.number:
    displayName: "#"
  file.name:
    displayName: Record
  note.status:
    displayName: Status
  formula.created:
    displayName: Created
  note.summary:
    displayName: Summary
  note.superseded_by:
    displayName: Superseded by
  note.partially_superseded_by:
    displayName: Partly superseded by
views:
  - type: table
    name: Decisions
    filters:
      and:
        - status != "rejected"
    order:
      - note.number
      - file.name
      - note.status
      - formula.created
      - note.summary
      - note.superseded_by
      - note.partially_superseded_by
    sort:
      - property: note.number
        direction: ASC
  - type: table
    name: Decided against
    filters:
      and:
        - status == "rejected"
    order:
      - note.number
      - file.name
      - formula.created
      - note.summary
    sort:
      - property: note.number
        direction: ASC
