# The design index: every record in decisions/, by number, and what superseded it in whole or in part
# (template-obsidian decisions 0001 and 0002).
# Template-owned: copier update replaces it. Want another view? Add a base of your own.
filters:
  and:
    - file.inFolder("decisions")
    - kind == "decision"
properties:
  note.number:
    displayName: "#"
  file.name:
    displayName: Record
  note.status:
    displayName: Status
  note.date:
    displayName: Date
  note.summary:
    displayName: Summary
  note.superseded_by:
    displayName: Superseded by
  note.partially_superseded_by:
    displayName: Partly superseded by
views:
  - type: table
    name: Decisions
    filters:
      and:
        - status != "rejected"
    order:
      - note.number
      - file.name
      - note.status
      - note.date
      - note.summary
      - note.superseded_by
      - note.partially_superseded_by
    sort:
      - property: note.number
        direction: ASC
  - type: table
    name: Decided against
    filters:
      and:
        - status == "rejected"
    order:
      - note.number
      - file.name
      - note.date
      - note.summary
    sort:
      - property: note.number
        direction: ASC
