{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {"commit": "", "pr": "", "sessionUrl": false},
  "permissions": {
    "allow": [
      "Bash(sh scripts/checks.sh:*)",
      "Bash(uv run scripts/check-vault.py:*)",
      "Bash(sh scripts/check.sh:*)",
      "Bash(scripts/check-docs-secrets.sh:*)",
      "Bash(gh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Edit(.copier-answers.*.yml)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/main *)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--tags*)",
      "Bash(git push *--follow-tags*)",
      "Bash(git tag:*)",
      "Bash(gh release:*)",
      "Bash(gh api *releases*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo archive:*)",
      "Bash(gh pr create *-R *)",
      "Bash(gh pr create *--repo*)",
      "Read(./[[ vault ]].trash/**)",
      "Read(./.graphify/**)",
      "Read(./graphify-out/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/repo-boundary.py\""}]
      }
    ]
  }
}
